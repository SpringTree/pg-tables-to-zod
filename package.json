{
  "name": "pg-tables-to-zod",
  "version": "2.0.0",
  "description": "A command-line utility and module to turn postgres tables into Zod schemas",
  "homepage": "https://github.com/SpringTree/pg-tables-to-zod#readme",
  "bugs": {
    "url": "https://github.com/SpringTree/pg-tables-to-zod/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpringTree/pg-tables-to-zod.git"
  },
  "bin": {
    "pgtables2zod": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "pg-structure": "^7.15.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
