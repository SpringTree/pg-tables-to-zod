"import { z } from "zod";

export const JsonTypeSchema = z.json().describe('Postgresql JSON type');

export type TJsonType = z.infer<typeof JsonTypeSchema>;

export const PostgresqlIntervalSchema = z.union([
    		z.number().describe('Interval duration in seconds'),
    		z.string().describe('Descriptive interval duration i.e. 8 hours'),
    		z
    			.strictObject({
    				years: z.number().optional(),
    				months: z.number().optional(),
    				days: z.number().optional(),
    				hours: z.number().optional(),
    				minutes: z.number().optional(),
    				seconds: z.number().optional(),
    				milliseconds: z.number().optional(),
    			})
    			.describe('Interval duration as an object'),
    	])
    	.describe('Postgresql interval type');

export type TPostgresqlInterval = z.infer<typeof PostgresqlIntervalSchema>;

export const QuoteStyleSchema = z.enum(['it\\'s','back\\\\\\\\slash','tick\`','\${placeholder}']).describe(\`Enum with \\\`backticks\\\`, \\\${braces} and a \\\\ backslash\`);

export type EQuoteStyle = z.infer<typeof QuoteStyleSchema>;

export const OrderStatusSchema = z.enum(['new','paid','shipped']).describe(\`Status of an order\`);

export type EOrderStatus = z.infer<typeof OrderStatusSchema>;

export const PrioritySchema = z.enum(['low','high']);

export type EPriority = z.infer<typeof PrioritySchema>;
"
,
  },
  {
