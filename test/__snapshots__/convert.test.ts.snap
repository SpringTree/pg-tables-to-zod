    		email: z.string().max(120).describe(\`The customer's e-mail. Database type: character varying. Default value: \`),
    		country_code: z.string().max(2).describe(\`Fixture. Database type: character. Default value: \`),
    		display_name: z.string().describe(\`Fixture. Database type: text. Default value: \`).optional(),
    		avatar: z.string().describe(\`Fixture. Database type: bytea. Default value: \`).optional(),
    		flags: z.string().max(3).describe(\`Fixture. Database type: bit. Default value: \`).optional(),
    		feature_mask: z.string().max(8).describe(\`Fixture. Database type: bit varying. Default value: \`).optional(),
    		is_active: z.boolean().describe(\`Fixture. Database type: boolean. Default value: true\`).optional(),
    		login_count: z.int().describe(\`Fixture. Database type: integer. Default value: 0\`).optional(),
    		visits: z.number().describe(\`Fixture. Database type: bigint. Default value: \`).optional(),
    		balance: z.number().describe(\`Fixture. Database type: numeric. Default value: \`).optional(),
    		score: z.number().describe(\`Fixture. Database type: double precision. Default value: \`).optional(),
    		ratio: z.number().describe(\`Fixture. Database type: real. Default value: \`).optional(),
    		rank: z.int().describe(\`Fixture. Database type: smallint. Default value: \`).optional(),
    		birth_date: z.iso.date().describe(\`Fixture. Database type: date. Default value: \`).optional(),
    		wakes_at: z.iso.time().describe(\`Fixture. Database type: time without time zone. Default value: \`).optional(),
    		wakes_at_tz: z.iso.time().describe(\`Fixture. Database type: time with time zone. Default value: \`).optional(),
    		created_at: z.iso.datetime().describe(\`Fixture. Database type: timestamp with time zone. Default value: now()\`).optional(),
    		updated_at: z.iso.datetime().describe(\`Fixture. Database type: timestamp without time zone. Default value: \`).optional(),
    		preferences: z.json().describe(\`Fixture. Database type: jsonb. Default value: '{}'\`).optional(),
    		raw_preferences: z.json().describe(\`Fixture. Database type: json. Default value: \`).optional(),
    		tags: z.array(z.string()).describe(\`Fixture. Database type: text. Default value: \`).optional(),
    		lucky_numbers: z.array(z.int()).describe(\`Fixture. Database type: integer. Default value: \`).optional(),
    		ip_address: z.any().describe(\`Fixture. Database type: inet. Default value: \`).optional()
    	})
    	.describe(\`A customer's account\`);

export type TCustomerAccount = z.infer<typeof customerAccountSchema>;

export default customerAccountSchema;
